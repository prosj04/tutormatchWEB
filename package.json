{
  "name": "premium-tutoring",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check-env": "ts-node --transpile-only -O '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/check-env.ts",
    "setup-storage": "ts-node --transpile-only -O '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/setup-storage.ts",
    "seed:sample": "ts-node --transpile-only -O '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/seed-sample-data.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "5.22.0",
    "@supabase/supabase-js": "^2.105.4",
    "@tosspayments/payment-widget-sdk": "^0.12.1",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.38.0",
    "next": "14.2.35",
    "next-auth": "^5.0.0-beta.31",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
