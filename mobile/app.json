{
  "expo": {
    "name": "Concord",
    "slug": "concord",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "concord",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.concord.tutoring",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "프로필 사진과 증빙 서류를 업로드하기 위해 사진 보관함에 접근합니다."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.concord.tutoring"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진과 증빙 서류를 업로드하기 위해 사진 보관함에 접근합니다."
        }
      ],
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2563eb"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
