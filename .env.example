# ── Supabase / Prisma ────────────────────────────────────────────────────────
# Pooled connection via Supavisor (port 6543) — used at runtime by Prisma.
# Add both variables to Vercel → Settings → Environment Variables.
# connection_limit=1 이면 같은 요청에서 Prisma 병렬 쿼리(Promise.all) 불가 — 코드는 순차·cache() 처리함
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (port 5432) — used only by `prisma migrate deploy`.
# Do NOT expose this through the pooler URL above.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.supabase.com:5432/postgres"

# ── 상담·등록 (선택) ─────────────────────────────────────────────────────────
# 즉시 등록 시 배정할 대표 매니저 이메일 (미설정 시 첫 MANAGER 계정)
DEFAULT_MANAGER_EMAIL=""

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# 배포에서는 AUTH_SECRET(또는 NEXTAUTH_SECRET) 필수 — 없으면 JWT/로그인이 불안정해질 수 있음.
# NEXTAUTH_URL / AUTH_URL 값은 「스킴 + 호스트 (+ 끝 /)」만 허용. /login 같은 경로를 붙이지 마세요.
# (경로가 붙으면 Auth가 basePath를 잘못 잡아 /api/auth와 불일치 → 전원 로그인 실패)
AUTH_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="https://tutormatch-web.vercel.app/"
AUTH_URL=""

# ── Admin bootstrap / 복구 ─────────────────────────────────────────────────
# /login?setup=admin — 최초 관리자 1명 생성, 또는 기존 ADMIN 비밀번호 재설정(API) 시 사용
# production에서는 필수로 설정하세요.
ADMIN_SETUP_SECRET=""

# ── Supabase client (public, safe to expose) ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Storage 버킷 생성 스크립트(npm run setup-storage) 전용 — 서버에만 두고 커밋 금지
SUPABASE_SERVICE_ROLE_KEY=""

# ── 포털 디자인 (대시보드·선생님·관리자) ─────────────────────────────────────
# concord (기본) | legacy — legacy로 설정하면 기존 Tailwind 고정 색 셸로 복원
# NEXT_PUBLIC_PORTAL_DESIGN="legacy"
# 브라우저에서 localStorage.setItem('portal-design-override','legacy') 로도 즉시 전환 가능
