generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// 사용자 역할. String → enum으로 승격되어 오타/누락 케이스가 컴파일 타임에 잡힘.
enum UserRole {
  ADMIN
  CHIEF_MANAGER
  MANAGER
  TEACHER
  STUDENT
  PARENT
}

/// 상담 예약 상태. 코드에서 쓰이는 4개 값을 모두 enum 값으로 포함.
enum ConsultationStatus {
  WAITING
  ASSIGNED
  COMPLETED
  CANCELLED
}

/// 수업 상태. 기본값 SCHEDULED 유지.
enum LessonStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

/// 구독 상태. 기본값 ACTIVE 유지.
enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
}

/// 선생님-학생 매칭 상태. 기본값 PENDING_STUDENT_ACCEPT 유지.
enum MatchStatus {
  PENDING_STUDENT_ACCEPT
  ACTIVE
  CANCELLED
}

/// 결제 완료 처리 상태. 기본값 PROCESSING 유지.
enum PaymentStatus {
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  role          UserRole       @default(STUDENT)
  student       Student?
  teacher       Teacher?
  parent        Parent?
  notifications Notification[]
  pushDevices   PushDevice[]
  createdAt     DateTime       @default(now())
  deletedAt     DateTime?
}

model Student {
  id                  String               @id @default(uuid())
  userId              String               @unique
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  grade               String
  subjects            String
  phone               String
  guardianPhone       String?
  /// "MALE" | "FEMALE" — 기본 프로필 이미지 구분
  gender              String?
  /// 거주 지역 (예: "서울", "분당·판교") — 방문 수업 가능 여부 판단용
  region              String?
  plans               StudyPlan[]
  questions           Question[]
  teachers            TeacherStudent[]
  consultationBookings ConsultationBooking[]
  managerLinks        ManagerStudent[]
  managerCareLogs     ManagerCareLog[]
  lessons             Lesson[]
  reviews             TutorReview[]
  studySessions       StudySession[]
  subscriptions       Subscription[]
  paymentCompletions  PaymentCompletion[]
  tokenWallets        TokenWallet[]
  monthlyReports      MonthlyReport[]
  questionMessages    QuestionMessage[]
  onboardingSurvey    OnboardingSurvey?
  satisfactionCheckins SatisfactionCheckin[]
  guardianConsentAt   DateTime?
  billingProfile      BillingProfile?
  parentLinks         ParentStudent[]
  parentLinkCodes     ParentLinkCode[]
  deletedAt           DateTime?
}

/// 학부모 계정. 학생과 별개 계정으로 로그인하며 1명이 여러 자녀와 연결될 수 있다.
model Parent {
  id        String          @id @default(uuid())
  userId    String          @unique
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  children  ParentStudent[]
  createdAt DateTime        @default(now())
  deletedAt DateTime?
}

/// 학부모–자녀(학생) 연결. 코드/QR/매니저 수동 연결로 생성.
model ParentStudent {
  id        String   @id @default(uuid())
  parentId  String
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// 연결 방식: "CODE" | "QR" | "MANAGER"
  linkedVia String   @default("CODE")
  createdAt DateTime @default(now())

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
}

/// 학생이 앱에서 발급하는 학부모 연결용 1회성 코드(QR도 동일 코드를 인코딩).
model ParentLinkCode {
  id        String    @id @default(uuid())
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  code      String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([studentId])
}

model Teacher {
  id                String                @id @default(uuid())
  userId            String                @unique
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  phone             String
  subjects          String
  bio               String
  education         String
  experience        String
  /// 공개 강사진 사진 구분: "MALE" | "FEMALE" (미설정 시 남성 기본 이미지)
  gender            String?
  /// 정산 시급(원). null = 기본 30,000. 관리자 수동 지정 — 프리셋 32,000/34,000/40,000
  hourlyRateKrw     Int?
  approved          Boolean               @default(false)
  profile           TeacherProfile?
  students          TeacherStudent[]
  managerBookings   ConsultationBooking[]
  managerStudents   ManagerStudent[]      @relation("ManagerStudents")
  managerCareLogs   ManagerCareLog[]      @relation("ManagerCareLogs")
  lessons           Lesson[]
  reviews           TutorReview[]
  availabilities    TutorAvailability[]
  questionMessages  QuestionMessage[]
  homeworkTemplates HomeworkTemplate[]

  @@index([approved])
}

model TeacherStudent {
  id          String    @id @default(uuid())
  teacherId   String
  studentId   String
  teacher     Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjects    String // 이 매칭에서 담당하는 과목 (comma-separated)
  startDate   String // "2024-01-01"
  isActive    Boolean   @default(true)
  // 학생의 명시적 배정 수락 상태. "PENDING_STUDENT_ACCEPT" | "ACTIVE".
  // isActive와 항상 동기화되어야 하며, 당분간 매칭 활성 로직은 isActive를 기준으로 한다.
  matchStatus MatchStatus @default(PENDING_STUDENT_ACCEPT)
  respondedAt DateTime?
  matchReason String?   // 담당 매니저가 이 선생님을 선택한 이유
  createdAt   DateTime  @default(now())

  @@unique([teacherId, studentId])
  @@index([teacherId])
  @@index([studentId])
  @@index([isActive])
  @@index([matchStatus])
  @@index([studentId, matchStatus])
}

model StudyPlan {
  id        String      @id @default(uuid())
  studentId String
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      String // "2024-01-15" format
  tasks     StudyTask[]
  comment   String? // 강사 코멘트
  commentAt DateTime?
  commentBy String? // Teacher id
  source    String      @default("MANUAL") // "MANUAL" | "AUTO_DISTRIBUTION"
  createdAt DateTime    @default(now())

  @@index([studentId])
  @@index([date])
  @@index([studentId, date])
}

model StudyTask {
  id     String    @id @default(uuid())
  planId String
  plan   StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  title  String
  source String    @default("student") // "student" | "teacher"
  isDone Boolean   @default(false)
  doneAt DateTime?
  order  Int       @default(0)
}

/// DEPRECATED — 웹/앱 QnA는 `QuestionMessage`로 통합. 이 테이블은 롤백 대비 유지되며
/// 신규 코드는 QuestionMessage를 사용한다. 향후 정리 마이그레이션에서 DROP 예정.
model Question {
  id              String    @id @default(uuid())
  studentId       String
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date            String // 연결된 날짜 "2024-01-15"
  content         String
  imageUrl        String? // Supabase Storage URL
  aiAnswer        String?
  teacherAnswer   String?
  teacherAnswerAt DateTime?
  answeredBy      String? // Teacher id
  isResolved      Boolean   @default(false)
  createdAt       DateTime  @default(now())

  @@index([studentId])
  @@index([studentId, date])
  @@index([isResolved])
  @@index([createdAt])
}

model TeacherProfile {
  id           String   @id @default(uuid())
  teacherId    String   @unique
  teacher      Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  photoUrl     String?
  intro        String?
  career       String? // JSON string array
  education    String? // JSON string array
  certificates String? // JSON string array
  resumeUrls   String? // JSON string array, 이력서 파일 URL들
  documentUrls String? // JSON string array, 인증서류 파일 URL들
  updatedAt    DateTime @default(now()) @updatedAt
}

model ConsultationBooking {
  id                  String    @id @default(uuid())
  studentId           String
  student             Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  managerId           String?
  manager             Teacher?  @relation(fields: [managerId], references: [id])
  preferredTimes      String    @default("[]")
  visitPreferredTimes String    @default("{}")
  visitConfirmedAt    DateTime?
  status              ConsultationStatus @default(WAITING)
  note                String?
  managerNote         String?
  nextStep            String? // 완료 시 다음 단계: MATCHING | HOLD | CLOSED
  assignedAt          DateTime?
  followUpSentAt      DateTime?
  createdAt           DateTime  @default(now())
  report              ConsultationReport?

  @@index([managerId])
  @@index([status])
  @@index([managerId, status])
  @@index([status, createdAt])
  @@index([studentId, createdAt])
}

model ConsultationLead {
  id             String   @id @default(uuid())
  name           String?
  gender         String?
  region            String?
  phone          String
  grade          String
  subjects       String   @default("[]")
  preferredTime  String?
  marketingOptIn Boolean  @default(false)
  status         String   @default("NEW")
  // "NEW" | "CONTACTED" | "CONVERTED" | "CLOSED"
  source         String?
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  // "QUESTION_UNANSWERED" | "PROGRESS_WARNING" | "PROGRESS_DANGER"
  // | "NEW_BOOKING" | "BOOKING_CONFIRMED" | "TEACHER_ANSWERED"
  // | "SATISFACTION_LOW_SCORE"
  title     String
  body      String
  isRead    Boolean  @default(false)
  relatedId String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, isRead])
}

model ManagerStudent {
  id        String   @id @default(uuid())
  managerId String
  manager   Teacher  @relation("ManagerStudents", fields: [managerId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([managerId, studentId])
  @@index([managerId])
  @@index([studentId])
}

model ManagerCareLog {
  id              String   @id @default(uuid())
  managerId       String
  manager         Teacher  @relation("ManagerCareLogs", fields: [managerId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type            String   // "CONSULT" | "INTERVENTION" | "CHECK"
  note            String
  visibleToStudent Boolean @default(true)
  createdAt       DateTime @default(now())

  @@index([studentId])
  @@index([managerId])
}

model SatisfactionCheckin {
  id         String    @id @default(uuid())
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  trigger    String    @default("FIRST_LESSON_D7") // e.g. "FIRST_LESSON_D7"
  score      Int?      // 1-5
  comment    String?
  requestedAt DateTime @default(now())
  respondedAt DateTime?

  @@unique([studentId, trigger])
  @@index([studentId])
}

model SiteContent {
  id        String   @id @default(uuid())
  section   String // "hero" | "stats" | "testimonials" | "faq" | "cta" | "features"
  key       String // e.g. "headline", "subtext", "stat1_number"
  value     String // actual content (text or image URL)
  type      String   @default("text") // "text" | "image" | "number"
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
  updatedBy String? // admin user id

  @@unique([section, key])
}

model Testimonial {
  id                String   @id @default(uuid())
  title             String? // 카드 상단 2줄 제목 (줄바꿈 허용)
  quote             String
  author            String // e.g. "고2 · 수학 · 학부모"
  imageUrl          String?
  gradeFrom         String? // e.g. "3등급" — 성적 변화 뱃지 시작
  gradeTo           String? // e.g. "1등급" — 성적 변화 뱃지 도착
  category          String? // 고민 카테고리: 성적정체·기초부족·자신감하락·습관부재
  tags              String? // 줄바꿈 구분 태그
  order             Int      @default(0)
  isActive          Boolean  @default(true)
  showOnHome        Boolean  @default(false)
  showOnReviewsPage Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model FaqItem {
  id            String   @id @default(uuid())
  question      String
  answer        String
  order         Int      @default(0)
  isActive      Boolean  @default(true)
  showOnHome    Boolean  @default(false)
  showOnFaqPage Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── 모바일 앱 전용 모델 ───────────────────────────────────────────

/// 예약된 수업 (홈 '오늘 수업'·'다가오는 일정', 입장 버튼)
model Lesson {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject     String
  startAt     DateTime
  durationMin Int      @default(50)
  joinUrl     String?
  status      LessonStatus @default(SCHEDULED)
  cancelledBy String? // "TEACHER" | "STUDENT" | "MANAGER" | "SYSTEM"(D+7 무응답 이월) (only set when status is CANCELLED)
  cancelReason String? // 취소 사유(선생님 입력, 선택)
  confirmedAt   DateTime? // 수업 확인 제도: 선생님이 완료/미완료 확인을 마친 시각(무응답 자동 처리 포함)
  notHeldReason String? // 미완료 사유(선생님 선택 또는 직접 입력)
  notHeldFault  String? // "STUDENT"(학생 과실·정산 포함) | "NOT_STUDENT"(비학생 과실·이월)
  createdAt   DateTime @default(now())

  @@index([studentId])
  @@index([studentId, startAt])
  @@index([teacherId])
  @@index([status])
}

/// 강사 평점/후기 (선생님 찾기·프로필 평점)
model TutorReview {
  id        String   @id @default(uuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rating    Int // 1–5
  comment   String?
  createdAt DateTime @default(now())

  @@unique([teacherId, studentId])
  @@index([teacherId])
}

/// 강사 상담 가능 시간 슬롯 (프로필 SlotGrid)
model TutorAvailability {
  id        String   @id @default(uuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  weekday   Int // 0(일)–6(토)
  time      String // "19:00"
  isOpen    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([teacherId, weekday, time])
  @@index([teacherId])
}

/// 일자별 학습 시간 (내 학습 주간 막대)
model StudySession {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      String // "2024-01-15"
  minutes   Int      @default(0)
  source    String? // "lesson" | "self" | "homework"
  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([studentId, date])
}

/// 구독/플랜 상태 (AI 토큰 할당량 산정 근거)
model Subscription {
  id          String    @id @default(uuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  plan        String // pricing-plans id e.g. "8-1"
  status      SubscriptionStatus @default(ACTIVE)
  periodStart DateTime  @default(now())
  periodEnd   DateTime?
  pausedAt    DateTime?
  pausedUntil DateTime?
  createdAt   DateTime  @default(now())

  @@index([studentId])
  @@index([studentId, status])
}

/// 결제 완료 처리 기록 (주문번호 기준 멱등성 보장)
model PaymentCompletion {
  id              String    @id @default(uuid())
  orderId         String    @unique
  studentId       String
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  plan            String
  status          PaymentStatus @default(PROCESSING)
  paymentKey      String?
  amount          Int?
  subscriptionId  String?
  bookingId       String?
  cashReceiptType String? // e.g. "PERSONAL" | "BUSINESS"
  cashReceiptUrl  String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  updatedAt       DateTime  @default(now()) @updatedAt

  @@index([studentId])
  @@index([studentId, status])
}

/// Toss 빌링키 프로필 (자동결제 카드 등록). Subscription 이력을 불변으로 유지하기
/// 위해 별도 테이블로 분리한다. customerKey는 `student-{studentId}` 규약.
model BillingProfile {
  id                String   @id @default(uuid())
  studentId         String   @unique
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  customerKey       String   @unique
  billingKey        String
  cardCompany       String?
  cardNumberMasked  String?
  autoRenew         Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
}

/// AI 질답 토큰 지갑 (월별 사용/할당량)
model TokenWallet {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  month     String // "2024-01"
  used      Int      @default(0)
  quota     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([studentId, month])
  @@index([studentId])
}

/// 월간 리포트 (내 학습 '취약 유형 분석')
model MonthlyReport {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  month     String // "2024-01"
  summary   String
  weakTypes String   @default("[]") // JSON string array
  detail    String?
  overallScore   Int?    // 이번 달 종합 점수(완료율 기반 0~100)
  prevScore      Int?    // 전월 overallScore(없으면 null)
  subjectScores  String? // JSON [{subject, prev, curr}] 과목별 완료율
  teacherComment String? // 그 달 최신 선생님 플랜 코멘트 원문
  managerComment String? // 그 달 최신 매니저 CareLog note(학부모 공개분)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([studentId, month])
  @@index([studentId])
}

/// Q&A 통합 메시지 스토어. 학생·강사·AI 발화가 하나의 시간순 시퀀스로 저장된다.
/// - 루트(학생 발화): sender="me", replyToId=null. 웹 카드 뷰의 "질문"에 대응.
/// - 답변(강사/AI): sender="tutor"|"ai", replyToId=루트 메시지 id.
/// - 웹은 (루트 + replies) 뷰, 모바일은 flat 시간순 리스트로 소비한다.
model QuestionMessage {
  id         String            @id @default(uuid())
  studentId  String
  student    Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId  String?
  teacher    Teacher?          @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  sender     String // "me" | "tutor" | "ai"
  body       String
  imageUrl   String?
  tokenCost  Int               @default(0)
  /// 웹 대시보드에서 특정 날짜 카드에 연결된 학생 질문. 답변 메시지는 null.
  date       String?
  /// 루트 메시지에만 유효. 학생이 "해결됨"으로 표시하면 true.
  isResolved Boolean           @default(false)
  /// 답변(tutor/ai) 메시지의 부모(=학생 루트) 메시지. 루트는 null.
  replyToId  String?
  parent     QuestionMessage?  @relation("QuestionMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies    QuestionMessage[] @relation("QuestionMessageReplies")
  createdAt  DateTime          @default(now())

  @@index([studentId])
  @@index([studentId, teacherId])
  @@index([studentId, teacherId, createdAt])
  @@index([studentId, date])
  @@index([replyToId])
  @@index([studentId, replyToId])
  @@index([isResolved])
}

/// 푸시 디바이스 등록 (Expo Push)
model PushDevice {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expoPushToken String   @unique
  platform      String? // "ios" | "android"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([userId])
}

/// 온보딩 설문 (성적·목표·성향)
model OnboardingSurvey {
  id        String   @id @default(uuid())
  studentId String   @unique
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  grade     String?
  goal      String?
  style     String?
  data      String   @default("{}") // 추가 응답 JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

/// 클라이언트·서버 분석 이벤트 (웹/앱 공통)
model AnalyticsEvent {
  id        String   @id @default(uuid())
  name      String
  platform  String   @default("web") // "web" | "mobile"
  userId    String?
  payload   String   @default("{}")
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model HomeworkTemplate {
  id           String   @id @default(uuid())
  teacherId    String
  teacher      Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title        String
  subject      String?
  tasks        String   @default("[]") // JSON array of task objects with title & weight
  defaultDays  Int      @default(7)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([teacherId])
  @@index([isDefault])
}

model ConsultationReport {
  id                  String   @id @default(uuid())
  bookingId           String   @unique
  booking             ConsultationBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  goals               String   @default("{}") // JSON: { quantitative: [], qualitative: [] }
  subjectLevels       String? // JSON object mapping subjects to proficiency levels
  recommendedPlan     String?
  note                String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([bookingId])
}

/// BR-15: 개인정보 접근·변경 기록 (1년 보관 요건)
/// No FK relations — actorUserId is a plain string for decoupling.
model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String
  actorRole   String
  action      String
  targetType  String
  targetId    String
  detail      String?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
}
