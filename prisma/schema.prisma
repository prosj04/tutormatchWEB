generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  role          String         @default("STUDENT") // "STUDENT" | "TEACHER" | "MANAGER" | "ADMIN"
  student       Student?
  teacher       Teacher?
  notifications Notification[]
  createdAt     DateTime       @default(now())
}

model Student {
  id            String                @id @default(uuid())
  userId        String                @unique
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  grade         String
  subjects      String
  phone         String
  plans         StudyPlan[]
  questions     Question[]
  teachers      TeacherStudent[]
  bookings      ConsultationBooking[]
  managerLinks  ManagerStudent[]
}

model Teacher {
  id              String             @id @default(uuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  phone           String
  subjects        String
  bio             String
  education       String
  experience      String
  approved        Boolean            @default(false)
  profile         TeacherProfile?
  students        TeacherStudent[]
  managerSlots    ConsultationSlot[] @relation("ManagerSlots")
  managerStudents ManagerStudent[]   @relation("ManagerStudents")
}

model TeacherStudent {
  id        String   @id @default(uuid())
  teacherId String
  studentId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjects  String   // 이 매칭에서 담당하는 과목 (comma-separated)
  startDate String   // "2024-01-01"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([teacherId, studentId])
}

model StudyPlan {
  id        String      @id @default(uuid())
  studentId String
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      String      // "2024-01-15" format
  tasks     StudyTask[]
  comment   String?     // 강사 코멘트
  commentAt DateTime?
  commentBy String?     // Teacher id
  createdAt DateTime    @default(now())
}

model StudyTask {
  id     String    @id @default(uuid())
  planId String
  plan   StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  title  String
  isDone Boolean   @default(false)
  doneAt DateTime?
  order  Int       @default(0)
}

model Question {
  id              String    @id @default(uuid())
  studentId       String
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date            String    // 연결된 날짜 "2024-01-15"
  content         String
  imageUrl        String?   // Supabase Storage URL
  aiAnswer        String?
  teacherAnswer   String?
  teacherAnswerAt DateTime?
  answeredBy      String?   // Teacher id
  isResolved      Boolean   @default(false)
  createdAt       DateTime  @default(now())
}

model TeacherProfile {
  id           String   @id @default(uuid())
  teacherId    String   @unique
  teacher      Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  photoUrl     String?
  intro        String?
  career       String?  // JSON string array
  education    String?  // JSON string array
  certificates String?  // JSON string array
  updatedAt    DateTime @default(now()) @updatedAt
}

model ConsultationSlot {
  id        String               @id @default(uuid())
  managerId String
  manager   Teacher              @relation("ManagerSlots", fields: [managerId], references: [id], onDelete: Cascade)
  date      String               // "2024-01-15"
  startTime String               // "14:00"
  endTime   String               // "14:30"
  isBooked  Boolean              @default(false)
  booking   ConsultationBooking?
  createdAt DateTime             @default(now())
}

model ConsultationBooking {
  id          String           @id @default(uuid())
  slotId      String           @unique
  slot        ConsultationSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  managerId   String
  status      String           @default("PENDING")
  // "PENDING" | "CONFIRMED" | "COMPLETED" | "CANCELLED"
  note        String?
  managerNote String?
  createdAt   DateTime         @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  // "QUESTION_UNANSWERED" | "PROGRESS_WARNING" | "PROGRESS_DANGER"
  // | "NEW_BOOKING" | "BOOKING_CONFIRMED" | "TEACHER_ANSWERED"
  title     String
  body      String
  isRead    Boolean  @default(false)
  relatedId String?
  createdAt DateTime @default(now())
}

model ManagerStudent {
  id        String   @id @default(uuid())
  managerId String
  manager   Teacher  @relation("ManagerStudents", fields: [managerId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([managerId, studentId])
}
